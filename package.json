{
  "name": "@oobleck/systheme",
  "version": "0.0.0",
  "private": true,
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/index.css"
  },
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "validate:ds": "tsx scripts/validate-anatomy.ts",
    "validate:ds:strict": "tsx scripts/validate-anatomy.ts --strict",
    "test": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:watch": "vitest --config vitest.config.ts",
    "test:ui": "vitest --ui --config vitest.config.ts",
    "test:cov": "vitest run --coverage --config vitest.config.ts",
    "test:stories": "vitest run --project storybook --config vitest.workspace.ts",
    "test:ct": "rm -rf playwright/.cache && playwright test --config=playwright-ct.config.ts",
    "test:ct:install": "playwright install chromium --with-deps",
    "chromatic": "chromatic --exit-zero-on-changes",
    "vr:lost-pixel": "lost-pixel",
    "vr:lost-pixel:update": "lost-pixel update",
    "size": "size-limit",
    "publint": "publint",
    "knip": "knip",
    "audit:coverage": "tsx scripts/audit-story-coverage.ts",
    "gen:design-md": "tsx scripts/generate-design-md.ts",
    "check:contrast": "node scripts/check-contrast.mjs"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "lucide-react": "^1.16.0",
    "mapbox-gl": "^3.22.0",
    "motion": "^12.40.0",
    "tailwind-merge": "^2.0.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/experimental-ct-react": "^1",
    "@playwright/test": "^1",
    "@size-limit/esbuild": "^11",
    "@size-limit/esbuild-why": "^11",
    "@size-limit/file": "^11",
    "@storybook/addon-a11y": "^8.0.0",
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/experimental-addon-test": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@types/d3": "^7.4.3",
    "@types/d3-sankey": "^0.12.5",
    "@types/geojson": "^7946.0.16",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4",
    "@vitest/browser": "^3",
    "@vitest/coverage-v8": "^3",
    "@vitest/runner": "^3",
    "@vitest/ui": "^3",
    "ajv": "^8",
    "ajv-formats": "^3",
    "chromatic": "^11",
    "fast-check": "^3",
    "fast-glob": "^3",
    "jsdom": "^25",
    "knip": "^5",
    "lost-pixel": "^3",
    "playwright": "^1",
    "publint": "^0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "size-limit": "^11",
    "storybook": "^8.0.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vitest": "^3"
  },
  "description": "Systheme. MVOS 디자인 시스템. 예전 이름 @oobleck/systheme."
}
