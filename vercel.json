{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm storybook:build",
  "outputDirectory": "storybook-static",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
