        "children": [
          {
            "id": "content",
            "intent": "ornament",
            "slot": true
          },
          {
            "id": "dismiss",
            "intent": "dismiss",
            "writes": "open",
            "emits": "onOpenChange"
          }
        ]
      }
    ]
