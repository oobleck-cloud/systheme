    ],
    "limits": {
      "width": "max-w-sm. 안에서 스크롤"
    },
    "states": {
      "loading": "Skeleton"
    },
    "placement": [
      "Escape·바깥 클릭으로 닫힌다. 트리거는 aria-expanded"
    ],
    "examples": [
      "components-l1-popover--default"
    ]
