    "intent": "ornament",
    "children": [
      {
        "id": "trigger",
        "intent": "disclosure",
        "writes": "open",
        "emits": "onOpenChange",
        "slot": true
      },
      {
        "id": "panel",
        "intent": "overlay-surface",
