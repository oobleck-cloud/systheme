{
  "id": "editable-tag-field",
  "state": {
    "value": "string[]",
    "editing": "boolean",
    "draftValue": "string[]",
    "saving": "boolean"
  },
  "events": [
    "onSave",
    "onEditingChange"
  ],
  "usage": {
    "when": [
      "사용자가 한 항목의 다중 선택 값(역할·태그)을 그 자리에서 고칠 때 — 읽기(Badge 나열) ↔ 편집(MultiSelect) 토글",
      "저장이 비동기(서버 persist)일 때 — onSave 를 주면 saving 동안 잠근다"
    ],
    "avoid": [
      "폼 전체를 한꺼번에 제출하는 화면에는 쓰지 않는다 → FormField + MultiSelect",
      "자유 입력으로 태그를 새로 만드는 곳에는 쓰지 않는다 → TagSelect",
      "읽기 전용 태그 표시에는 쓰지 않는다 → Badge / Tag 나열"
    ],
    "limits": {
      "items": "태그 5개까지 한 셀. wrap 으로 흐르므로 넘으면 열 폭을 넓힌다",
      "label": "옵션 라벨은 Badge size=sm 한 줄. 6자 이내"
    },
    "states": {
      "loading": "saving=true — 편집·저장·취소·MultiSelect 잠금, 편집 모드 유지",
      "disabled": "편집·저장·취소 버튼 disabled. 태그는 그대로 보인다",
      "empty": "값 없으면 emptyFallback(기본 '—') + 수정 버튼",
      "error": "onSave 가 throw 하면 편집 모드를 유지해 재시도. 오류 문구는 호출부가 Toast 로"
    },
    "placement": [
      "표 셀·DescriptionRow 값 칸 안. 수정(연필) 아이콘은 태그 오른쪽 끝",
      "편집 모드는 MultiSelect → 저장(✓) → 취소(✕) 순"
    ],
    "examples": [
      "components-l2-editabletagfield--interactive",
      "components-l2-editabletagfield--in-table-cell",
      "components-l2-editabletagfield--empty",
      "components-l2-editabletagfield--saving"
    ]
  },
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "binding": "editing",
    "children": [
      {
        "id": "empty",
        "intent": "value-display",
        "binding": "value"
      },
      {
        "id": "tag",
        "intent": "value-display",
        "traversal": {
          "axis": "inline"
        },
        "iterates": "value",
        "as": "item",
        "child": {
          "id": "tag",
          "intent": "value-display",
          "binding": "item"
        }
      },
      {
        "id": "edit",
        "intent": "disclosure",
        "writes": "editing",
        "emits": "onEditingChange"
      },
      {
        "id": "editor",
        "intent": "value-input",
        "binding": "draftValue",
        "writes": "draftValue"
      },
      {
        "id": "save",
        "intent": "press-action",
        "emits": "onSave"
      },
      {
        "id": "cancel",
        "intent": "press-action",
        "writes": "editing",
        "emits": "onEditingChange"
      }
    ]
  }
}
