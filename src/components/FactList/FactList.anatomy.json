{
  "id": "fact-list",
  "state": {
    "title": "ReactNode",
    "aside": "ReactNode",
    "label": "ReactNode",
    "value": "ReactNode",
    "sub": "ReactNode",
    "figure": "ReactNode",
    "mark": "'ok' | 'warn' | 'none'",
    "tone": "'warning'",
    "separated": "boolean"
  },
  "anatomy": {
