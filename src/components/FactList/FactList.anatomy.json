      },
      {
        "id": "row",
        "intent": "field-rhythm",
        "binding": "value",
        "slot": true,
        "children": [
          {
            "id": "mark",
            "intent": "ornament",
            "binding": "mark"
          },
          {
            "id": "label",
            "intent": "value-display",
            "binding": "label"
          },
          {
            "id": "value",
            "intent": "value-display",
            "binding": "value"
          },
          {
            "id": "sub",
            "intent": "value-display",
            "binding": "sub"
          },
          {
            "id": "figure",
            "intent": "value-display",
            "binding": "figure"
          }
        ]
      }
    ]
