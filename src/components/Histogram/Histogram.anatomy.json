{
  "id": "histogram",
  "state": {
    "data": "number[]",
    "bins": "number | undefined",
    "colorIndex": "1 | 2 | 3 | 4 | 5 | 6"
  },
  "events": [
    "onBinClick"
  ],
  "usage": {
    "when": [
      "수치 하나의 분포(응답 시간·금액이 어디에 몰리는가)를 볼 때 — 원시 number[] 를 넘기면 구간(bin)을 나눈다",
      "bins 로 구간 수를 정하거나, 생략하면 Sturges 규칙 자동"
    ],
    "avoid": [
      "카테고리별 값에는 쓰지 않는다 → BarChart",
      "시간 순 값에는 쓰지 않는다 → LineChart",
      "분포 요약(중앙값·사분위)만 필요하면 쓰지 않는다 → BoxPlot",
      "여러 분포 비교에는 쓰지 않는다(단일 시리즈) → BoxPlot"
    ],
    "limits": {
      "items": "bins 10~30. 데이터 30건 미만이면 분포가 아니다 → Table",
      "width": "w-full, 높이 기본 300"
    },
    "states": {
      "empty": "data 가 비면 ChartFrame 빈 상태('표시할 데이터가 없습니다')"
    },
    "placement": [
      "title/description 은 ChartFrame. 구간 클릭은 onBinClick(min, max, count)"
    ],
    "examples": [
      "components-charts-histogram--default",
      "components-charts-histogram--custom-bins",
      "components-charts-histogram--skewed"
    ]
  },
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "children": [
      {
        "id": "x-axis",
        "intent": "plot-axis",
        "iterates": "xTicks",
        "as": "tick",
        "child": {
          "id": "tick-label",
          "intent": "value-display"
        }
      },
      {
        "id": "y-axis",
        "intent": "plot-axis",
        "iterates": "yTicks",
        "as": "tick",
        "child": {
          "id": "tick-label",
          "intent": "value-display"
        }
      },
      {
        "id": "series",
        "intent": "ornament",
        "iterates": "buckets",
        "as": "bucket",
        "child": {
          "id": "segment",
          "intent": "chart-series",
          "binding": "bucket",
          "emits": "onBinClick"
        }
      }
    ]
  }
}
