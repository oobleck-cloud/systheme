    "appearance": "'icon' | 'label'"
  },
  "events": [
    "onValueChange"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "binding": "value",
    "traversal": {
      "axis": "inline"
    },
    "iterates": "options",
    "as": "option",
    "child": {
      "id": "item",
      "intent": "select-option",
      "writes": "value",
      "emits": "onValueChange",
      "binding": "option.value"
    }
  },
  "usage": {
    "when": [
