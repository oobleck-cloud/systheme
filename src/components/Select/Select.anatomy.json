{
  "id": "select",
  "primitiveGroup": "combobox-picker",
  "state": {
    "value": "string | null",
    "open": "boolean",
    "search": "string",
    "density": "'compact' | 'default' | 'loose'"
  },
  "events": [
    "onChange",
    "onOpenChange"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "children": [
      {
        "id": "trigger",
        "intent": "disclosure",
        "writes": "open",
        "children": [
          {
            "id": "label",
            "intent": "value-display",
            "binding": "value"
          },
          {
            "id": "chevron",
            "intent": "state-indicator",
            "binding": "open"
          }
        ]
      },
      {
        "id": "panel",
        "intent": "overlay-surface",
        "binding": "open",
        "children": [
          {
            "id": "search-input",
            "intent": "value-input",
            "writes": "search"
          },
          {
            "id": "list",
            "traversal": {
              "axis": "block"
            },
            "iterates": "filteredOptions",
            "as": "option",
            "child": {
              "id": "option",
              "intent": "select-option",
              "writes": [
                "value",
                "open"
              ],
              "binding": "option"
            }
          }
        ]
      }
    ]
  },
  "usage": {
    "when": [
      "정해진 선택지 중 하나(5개 이상, 또는 공간이 좁을 때)"
    ],
    "avoid": [
      "2~4개면 SegmentedControl/Radio",
      "여러 개 고르면 MultiSelect",
      "검색이 필요하면 SearchFieldAutocomplete",
      "필터 셀렉트를 가로로 늘어놓지 않는다 — 기본 w-full 이라 세로로 쌓인다 → 필터 Popover 패널에 행으로"
    ],
    "limits": {
      "items": "목록 8행 높이, 이상은 스크롤",
      "label": "옵션 라벨 한 줄, 넘치면 말줄임"
    },
    "states": {
      "disabled": "값은 보이고 흐리게",
      "empty": "옵션 없음 문구",
      "error": "보더 error + 아래 helper"
    },
    "placement": [
      "라벨은 위(FormField)"
    ],
    "examples": [
      "components-l1-select--default"
    ]
  }
}
