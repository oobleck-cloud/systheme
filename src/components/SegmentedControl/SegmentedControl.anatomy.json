{
  "id": "segmented-control",
  "state": {
    "value": "string",
    "size": "'sm' | 'md'"
  },
  "events": [
    "onValueChange"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "binding": "value",
    "traversal": {
      "axis": "inline"
    },
    "iterates": "items",
    "as": "segment",
    "child": {
      "id": "item",
      "intent": "select-option",
      "writes": "value",
      "emits": "onValueChange",
      "binding": "segment.value"
    }
  },
  "usage": {
    "when": [
      "같은 데이터의 보기 전환(목록 | 지도, 일 | 주 | 월) 2~4개 — tablist 의미, 항상 하나가 선택돼 있다",
      "화살표·Home·End 로 즉시 전환(automatic activation)"
    ],
    "avoid": [
      "제출되는 폼 값이면 → Radio",
      "5개 이상이면 → Select",
      "화면(라우트) 전환이면 → TabBar",
      "선택 세그먼트에 primary 색을 쓰지 않는다 — 중립 raised(bg-background + border-subtle), 색 강조는 콘텐츠 선택에 양보"
    ],
    "limits": {
      "items": "2~4개",
      "label": "한 줄(whitespace-nowrap) 2~6자. block 이면 폭을 균등 분할"
    },
    "states": {
      "disabled": "전체(disabled) 또는 항목별(item.disabled) opacity-50. 비활성 항목은 키보드 순회에서 빠진다",
      "empty": "없다 — 항목 없이 그리지 않는다"
    },
    "placement": [
      "툴바 왼쪽 또는 헤더 밴드 우측 액션 자리. 폭을 채우려면 block"
    ],
    "examples": [
      "components-l2-segmentedcontrol--default",
      "components-l2-segmentedcontrol--block",
      "components-l2-segmentedcontrol--with-disabled-item"
    ]
  }
}
