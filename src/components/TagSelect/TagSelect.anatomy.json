{
  "id": "tag-select",
  "primitiveGroup": "combobox-picker",
  "state": {
    "value": "string[]",
    "open": "boolean",
    "search": "string",
    "density": "'compact' | 'default' | 'loose'"
  },
  "events": [
    "onChange",
    "onOpenChange"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "children": [
      {
        "id": "trigger",
        "intent": "disclosure",
        "writes": "open",
        "children": [
          {
            "id": "label",
            "intent": "value-display",
            "binding": "value"
          },
          {
            "id": "chevron",
            "intent": "state-indicator",
            "binding": "open"
          }
        ]
      },
      {
        "id": "panel",
        "intent": "overlay-surface",
        "binding": "open",
        "children": [
          {
            "id": "search-input",
            "intent": "value-input",
            "writes": "search"
          },
          {
            "id": "list",
            "traversal": {
              "axis": "block"
            },
            "iterates": "filteredOptions",
            "as": "option",
            "child": {
              "id": "option",
              "intent": "select-option",
              "writes": "value",
              "binding": "option"
            }
          }
        ]
      }
    ]
  },
  "usage": {
    "when": [
      "여러 값을 골라 칩으로 쌓아 보일 때(태그·담당자 다중 선택)"
    ],
    "avoid": [
      "하나만 고르면 → Select",
      "칩 표시가 필요 없으면 → MultiSelect",
      "자유 입력이 필요하면 → EditableTagField"
    ],
    "limits": {
      "items": "선택 8개까지 칩으로, 이상은 +N"
    },
    "states": {
      "disabled": "칩은 남기고 제거 버튼과 트리거를 막는다",
      "empty": "옵션이 없으면 '옵션 없음'",
      "error": "보더 error + 아래 helper"
    },
    "examples": [
      "components-l1-tagselect--default",
      "components-l1-tagselect--with-error",
      "components-l1-tagselect--disabled"
    ]
  }
}
