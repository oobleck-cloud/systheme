{
  "id": "memo-thread",
  "state": {
    "author": "string",
    "timestamp": "string",
    "body": "string",
    "deleted": "boolean",
    "comments": "MemoThreadComment[]",
    "expanded": "boolean",
    "draft": "string",
    "composerOpen": "boolean",
    "error": "string | null"
  },
  "events": [
    "onSubmitComment"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "children": [
      {
        "id": "header",
        "intent": "ornament",
        "children": [
          {
            "id": "author",
            "intent": "value-display",
            "binding": "author"
          },
          {
            "id": "timestamp",
            "intent": "value-display",
            "binding": "timestamp"
          },
          {
            "id": "body",
            "intent": "value-display",
            "binding": "body"
          }
        ]
      },
      {
        "id": "comments",
        "intent": "ornament",
        "children": [
          {
            "id": "toggle",
            "intent": "press-action",
            "writes": "expanded"
          },
          {
            "id": "comment-list",
            "intent": "ornament",
            "traversal": {
              "axis": "block"
            },
            "iterates": "visibleComments",
            "as": "comment",
            "child": {
              "id": "comment",
              "intent": "ornament",
              "children": [
                {
                  "id": "comment-author",
                  "intent": "value-display",
                  "binding": "comment.author"
                },
                {
                  "id": "comment-timestamp",
                  "intent": "value-display",
                  "binding": "comment.timestamp"
                },
                {
                  "id": "comment-body",
                  "intent": "value-display",
                  "binding": "comment.body"
                }
              ]
            }
          }
        ]
      },
      {
        "id": "compose-open",
        "intent": "press-action",
        "writes": "composerOpen"
      },
      {
        "id": "compose",
        "intent": "ornament",
        "children": [
          {
            "id": "compose-input",
            "intent": "value-input",
            "writes": "draft"
          },
          {
            "id": "compose-error",
            "intent": "value-display",
            "binding": "error"
          },
          {
            "id": "compose-submit",
            "intent": "press-action",
            "emits": "onSubmitComment"
          },
          {
            "id": "compose-cancel",
            "intent": "press-action",
            "writes": "composerOpen"
          }
        ]
      }
    ]
  },
  "usage": {
    "when": [
      "메모 본문 1개 + 댓글 스레드(고객 메모·주문 메모) 를 시간순으로 읽고 댓글을 달 때",
      "기본 접힘: 최근 previewCount(2)개만 보이고 '댓글 N개 모두 보기' 로 펼친다",
      "댓글 입력창은 '댓글 달기' 를 누를 때 열린다 — 메모마다 펼쳐 두지 않는다"
    ],
    "avoid": [
      "시스템 이벤트·이력 나열에 쓰지 않는다 → Timeline",
      "댓글이 없는 메모 목록에 쓰지 않는다 → RichList / divide-y 행",
      "실시간 대화(채팅) 에 쓰지 않는다 — 스레드는 메모 1개에 종속된다"
    ],
    "limits": {
      "items": "접힘 시 최근 2개(previewCount). 본문·댓글은 자르지 않는다(whitespace-pre-wrap)",
      "label": "작성자·시각은 한 줄, 넘치면 줄바꿈(flex-wrap)"
    },
    "states": {
      "loading": "isSubmitting → 입력·취소 비활성, 등록 버튼 '등록 중…'",
      "error": "등록 실패 시 초안 유지 + 입력 아래 error 문구(role=alert). 접지 않는다",
      "empty": "댓글 0개면 댓글 영역을 그리지 않고 '댓글 달기' 만",
      "disabled": "deleted → 본문 취소선 '삭제된 메모입니다', 댓글 달기 숨김. 댓글도 deleted 면 '삭제된 댓글입니다'",
      "overflow": "본문 줄바꿈. 말줄임 없다"
    },
    "placement": [
      "댓글·입력창은 아바타 열만큼 들여쓴다(pl-11) — 컴포넌트가 잡는다",
      "메모 카드 사이 구분은 목록이 divide-y 로"
    ],
    "examples": [
      "components-l2-memothread--default",
      "components-l2-memothread--long-thread",
      "components-l2-memothread--deleted-memo"
    ]
  }
}
