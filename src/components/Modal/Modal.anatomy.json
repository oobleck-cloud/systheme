{
  "id": "modal",
  "primitiveGroup": "overlay-panel",
  "state": {
    "open": "boolean"
  },
  "events": [
    "onOpenChange"
  ],
  "anatomy": {
    "id": "root",
    "intent": "ornament",
    "children": [
      {
        "id": "backdrop",
        "intent": "dismiss",
        "writes": "open",
        "emits": "onOpenChange"
      },
      {
        "id": "dialog",
        "intent": "overlay-surface",
        "binding": "open",
        "children": [
          {
            "id": "header",
            "intent": "ornament",
            "children": [
              {
                "id": "title",
                "intent": "value-display",
                "slot": true
              },
              {
                "id": "description",
                "intent": "value-display",
                "slot": true
              },
              {
                "id": "close",
                "intent": "dismiss",
                "writes": "open",
                "emits": "onOpenChange"
              }
            ]
          },
          {
            "id": "body",
            "intent": "ornament",
            "slot": true
          },
          {
            "id": "footer",
            "intent": "ornament",
            "slot": true
          }
        ]
      }
    ]
  },
  "usage": {
    "when": [
      "지금 결정을 요구하는 짧은 대화(확인·입력 1~3개)",
      "되돌리기 어려운 동작의 확인"
    ],
    "avoid": [
      "긴 폼·목록에 쓰지 않는다 → Drawer/SideSheet",
      "정보만 보여주는 데 쓰지 않는다 → Popover/Tooltip",
      "모달 위에 모달을 열지 않는다"
    ],
    "limits": {
      "perRegion": 1,
      "width": "max-w-lg. 본문 최대 85vh, 안에서 스크롤"
    },
    "states": {
      "loading": "확인 버튼 loading, 닫기 막지 않는다",
      "error": "본문 상단 Alert"
    },
    "placement": [
      "액션은 하단 오른쪽: [취소][primary]. destructive 면 primary 자리에 destructive"
    ],
    "examples": [
      "components-l2-modal--default"
    ]
  }
}
